# Copy to .env for local development. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NODE_ENV=development
TOKEN_SECRET=change-me-shared-by-control-and-every-node
AGENT_SECRET=change-me-shared-by-control-and-every-node
ADMIN_KEY=change-me-control-server-admin-only
DB_PATH=veil.db
PORT=8787
NODE_ID=local-dev
PROXY_PORT=9100
AGENT_PORT=9101
CPM_USD=2.0
CPC_USD=0.10
# On a provisioned node these are written to /etc/veil-node.env when VLESS or Shadowsocks is enabled.
# Leave them unset in local development.
# XRAY_REALITY_ADDR=127.0.0.1:2053
# XRAY_SS_ADDR=127.0.0.1:16080
# XRAY_VLESS_WS_ADDR=127.0.0.1:10481
# XRAY_SS_WS_ADDR=127.0.0.1:10482
# VLESS_WS_PATH=
# VLESS_WS_UPSTREAM=
# SS_WS_PATH=
# SS_WS_UPSTREAM=
