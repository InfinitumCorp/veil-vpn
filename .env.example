# Copy to .env for local development. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NODE_ENV=development
TOKEN_SECRET=change-me-shared-by-control-and-every-node
AGENT_SECRET=change-me-shared-by-control-and-every-node
ADMIN_KEY=change-me-control-server-admin-only
DB_PATH=veil.db
PORT=8787
NODE_ID=local-dev
PROXY_PORT=9100
AGENT_PORT=9101
CPM_USD=2.0
CPC_USD=0.10

# @conjure: hosted Conjure prediction service. Key from the Conjure staff dashboard; server-side only.
CONJURE_URL=
CONJURE_PRODUCT_KEY=
