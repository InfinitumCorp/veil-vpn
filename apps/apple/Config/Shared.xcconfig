// https://api.infinitumveilvpn.app — the colon-slash is written so xcconfig does not treat // as a comment.
VEIL_CONTROL_URL = https:/$()/api.infinitumveilvpn.app
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
TARGETED_DEVICE_FAMILY = 1,2
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
ENABLE_USER_SCRIPT_SANDBOXING = NO
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_PREVIEWS = YES
GENERATE_INFOPLIST_FILE = NO
ALWAYS_SEARCH_USER_PATHS = NO
LIBRARY_SEARCH_PATHS = $(inherited) $(CONFIGURATION_BUILD_DIR) $(SRCROOT)/.build/wg-go/$(PLATFORM_NAME)
